# Dependencies
**/node_modules/

# Build and generated output
**/dist/
**/build/
**/coverage/
**/.next/
**/out/
**/.vite/
**/*.tsbuildinfo

# Local database runtime files
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite3

# Test output
**/test-results/
**/playwright-report/
**/.nyc_output/

# Local tool workspaces and caches
/.playwright-mcp/
/.vs/
**/.work/
**/.idea/

# Environment files and credentials
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/id_rsa
**/id_ed25519

# Logs and package-manager diagnostics
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# IDE and operating-system metadata
**/*.suo
**/*.user
**/*.userosscache
**/*.sln.docstates
**/.DS_Store
**/Thumbs.db
**/Desktop.ini

# Unrelated local scratch document (kept on disk)
